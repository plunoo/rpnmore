# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Google Gemini AI ──────────────────────────────────────────────────────────
# Required for AI blog post & image generation
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── Firebase Admin SDK ────────────────────────────────────────────────────────
# Required for Firestore (data persistence)
# How to get:
#   1. Firebase Console → Project Settings → Service Accounts
#   2. Click "Generate new private key" → download JSON
#   3. Paste the ENTIRE JSON contents here as a single line (minified)
# Example: {"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}
FIREBASE_SERVICE_ACCOUNT_KEY=

# ─── Admin Panel Password ──────────────────────────────────────────────────────
# Set at BUILD TIME in Dokploy's build args (not runtime env).
# Protects the admin dashboard from public access.
# Change this to a strong, unique password before deploying.
VITE_ADMIN_PASSWORD=change-me-before-deploy

# ─── PostgreSQL (Optional Backup) ─────────────────────────────────────────────
# Leave blank to use only Firebase + in-memory fallback
DATABASE_URL=
PGHOST=
PGUSER=
PGDATABASE=
PGPASSWORD=
PGPORT=5432
