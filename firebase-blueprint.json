{
  "entities": {
    "Service": {
      "title": "Service",
      "description": "A service offered by RPNMORE",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "icon": { "type": "string" },
        "imageUrl": { "type": "string" },
        "longDescription": { "type": "string" },
        "updates": { "type": "string" },
        "additionalInfo": { "type": "string" },
        "externalLink": { "type": "string" }
      },
      "required": ["id", "title", "description", "category", "icon"]
    },
    "BlogPost": {
      "title": "BlogPost",
      "description": "A blog post generated by AI",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "date": { "type": "string" },
        "author": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "title", "content", "date", "author"]
    }
  },
  "firestore": {
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Collection of services"
    },
    "/posts/{postId}": {
      "schema": "BlogPost",
      "description": "Collection of blog posts"
    }
  }
}
